{
  "name": "stl_allocator",
  "version": "1.2.0",
  "description": "Fixed block std::allocator for C++ standard library containers: xlist, xmap, xset, xstring, xmake_shared and more. Faster than the heap and no fragmentation.",
  "keywords": [
    "allocator",
    "stl",
    "std allocator",
    "memory pool",
    "fixed block",
    "containers",
    "heap",
    "embedded",
    "cpp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endurodave/stl_allocator.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/endurodave/stl_allocator",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "stl_allocator.h",
    "xlist.h",
    "xmap.h",
    "xqueue.h",
    "xset.h",
    "xsstream.h",
    "xstring.h",
    "xmake_shared.h",
    "xnew.h"
  ],
  "dependencies": [
    {
      "owner": "endurodave",
      "name": "xallocator",
      "version": "^1.3.0"
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "LICENSE",
      "README.md",
      "library.json",
      "library.properties"
    ],
    "exclude": [
      "**/.pio",
      "**/.pio/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "srcFilter": [
      "-<*>"
    ]
  },
  "examples": [
    {
      "name": "stl_allocator-demo",
      "base": "examples/platformio/stl_allocator-demo",
      "files": [
        "platformio.ini",
        "src/main.cpp"
      ]
    },
    {
      "name": "stl_allocator_Demo",
      "base": "examples/stl_allocator_Demo",
      "files": [
        "stl_allocator_Demo.ino"
      ]
    }
  ]
}
